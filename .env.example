# Copy to .env for local dev. Never commit .env.

# Postgres (Neon/Supabase). Leave unset locally to use embedded PGlite in ./.data
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Guards /admin/*. Generate with: openssl rand -hex 32
ADMIN_TOKEN=change-me-to-a-long-random-string-0000

# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_CAPABLE_MODEL=gemini-3.8-flash
# GEMINI_CHEAP_MODEL=gemini-3.5-flash-lite
# DEFAULT_REASONING_EFFORT=low

# Optional local model (stretch): ollama pull qwen2.5:1.5b
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:1.5b

# Defaults to true outside production, false in production.
# ENABLE_MOCK_PROVIDER=true

# PROVIDER_TIMEOUT_MS=12000
# REQUEST_DEADLINE_MS=28000
# USD_TO_INR=88
